# Copy this file to .env and fill in the values.
# Never commit .env to version control.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
QDRANT_ENDPOINT=
QDRANT_API_KEY=

# Qdrant client timeout in seconds (increase for large uploads)
QDRANT_TIMEOUT=120
# Number of points to upsert per batch (lower = fewer timeouts, slower upload)
QDRANT_BATCH_SIZE=32
